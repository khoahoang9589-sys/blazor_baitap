@page "/skills"
@layout CVLayout

<PageTitle>Skills - Clarence Taylor</PageTitle>

<section class="resume-section" id="skills">
    <div class="resume-section-content">
        <h2 class="mb-5">Skills</h2>

        <div class="subheading mb-3">Programming Languages & Tools</div>
        <ul class="list-inline dev-icons">
            <li class="list-inline-item" title="HTML5"><i class="fab fa-html5"></i></li>
            <li class="list-inline-item" title="CSS3"><i class="fab fa-css3-alt"></i></li>
            <li class="list-inline-item" title="JavaScript"><i class="fab fa-js-square"></i></li>
            <li class="list-inline-item" title="Angular"><i class="fab fa-angular"></i></li>
            <li class="list-inline-item" title="React"><i class="fab fa-react"></i></li>
            <li class="list-inline-item" title="Node.js"><i class="fab fa-node-js"></i></li>
            <li class="list-inline-item" title="Sass"><i class="fab fa-sass"></i></li>
            <li class="list-inline-item" title="Less"><i class="fab fa-less"></i></li>
            <li class="list-inline-item" title="WordPress"><i class="fab fa-wordpress"></i></li>
            <li class="list-inline-item" title="Gulp"><i class="fab fa-gulp"></i></li>
            <li class="list-inline-item" title="Grunt"><i class="fab fa-grunt"></i></li>
            <li class="list-inline-item" title="npm"><i class="fab fa-npm"></i></li>
        </ul>

        <div class="subheading mb-3">Workflow</div>
        <ul class="fa-ul mb-0">
            @foreach (var workflow in WorkflowList)
            {
                <li>
                    <span class="fa-li"><i class="fas fa-check text-primary"></i></span>
                    @workflow
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private List<string> WorkflowList = new()
    {
        "Mobile-First, Responsive Design",
        "Cross Browser Testing & Debugging",
        "Cross Functional Teams",
        "Agile Development & Scrum"
    };
}
